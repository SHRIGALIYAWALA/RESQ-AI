# Copy this file to .env and replace only the values you own.
# Never commit .env or paste these values into source code.

# Primary cloud reasoning provider
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Backup cloud reasoning provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Local offline fallback
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Local speech, voice, and vision
SPEECH_PROVIDER=faster-whisper
WHISPER_MODEL=small
TTS_PROVIDER=edge-tts
VISION_PROVIDER=yolo
YOLO_MODEL=yolo11n.pt

# Routing
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org

# Database: keep SQLite for local work, or use your Supabase PostgreSQL URL
DATABASE_URL=sqlite:///./resq_ai.db

# Local API security
REQUIRE_AUTH=false
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
API_KEY=

# Application settings
APP_ENV=demo
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.mp4,.wav,.mp3,.pdf
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
